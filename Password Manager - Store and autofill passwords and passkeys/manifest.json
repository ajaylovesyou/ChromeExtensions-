{
  "manifest_version": 3,
  "name": "CipherVault - Store & Autofill Passwords and Passkeys",
  "short_name": "CipherVault",
  "version": "1.0.0",
  "description": "Securely store, generate, and autofill passwords, passkeys, 2FA TOTP codes, payment cards, and private notes with zero-knowledge encryption.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CipherVault - Passwords & Passkeys",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/autofill-content.js"
      ],
      "css": [
        "content/autofill-content.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "commands": {
    "autofill_active_tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Autofill credentials for active website"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "test/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
